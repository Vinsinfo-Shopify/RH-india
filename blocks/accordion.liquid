{% liquid
  assign block_settings = block.settings
  assign product_item = closest.product | default: product

  assign dimensions_metafield = product_item.metafields.custom.dimensions
  assign details_points = product_item.metafields.custom.details_points.value
  assign fabric_pdf = product_item.metafields.custom.fabric_care_pdf.value
  assign regular_price = product_item.metafields.custom.regular_price.value
  assign member_price = product_item.metafields.custom.member_price.value
%}

<div class="pdp-info-accordion" {{ block.shopify_attributes }}>

  {% if block_settings.show_dimensions %}
    <details class="pdp-info-accordion__item">
      <summary class="pdp-info-accordion__heading">
        <span>{{ block_settings.dimensions_heading | escape }}</span>
        <span class="pdp-info-accordion__icon" aria-hidden="true"></span>
      </summary>

      <div class="pdp-info-accordion__content rte">
        {% if dimensions_metafield != blank %}
          {{ dimensions_metafield | metafield_tag }}
        {% elsif block_settings.dimensions_content != blank %}
          {{ block_settings.dimensions_content }}
        {% endif %}
      </div>
    </details>
  {% endif %}

  {% if block_settings.show_details %}
    <details class="pdp-info-accordion__item">
      <summary class="pdp-info-accordion__heading">
        <span>{{ block_settings.details_heading | escape }}</span>
        <span class="pdp-info-accordion__icon" aria-hidden="true"></span>
      </summary>

      <div class="pdp-info-accordion__content rte">
        {% if details_points != blank %}
          <ul class="pdp-info-accordion__list">
            {% for point in details_points %}
              <li>{{ point | escape }}</li>
            {% endfor %}
          </ul>
        {% elsif block_settings.details_content != blank %}
          {{ block_settings.details_content }}
        {% endif %}
      </div>
    </details>
  {% endif %}

  {% if block_settings.show_prices %}
    <details class="pdp-info-accordion__item">
      <summary class="pdp-info-accordion__heading">
        <span>{{ block_settings.prices_heading | escape }}</span>
        <span class="pdp-info-accordion__icon" aria-hidden="true"></span>
      </summary>

      <div class="pdp-info-accordion__content">
        {% if member_price != blank %}
          <p class="pdp-info-accordion__price-row">
            <span>{{ block_settings.member_label | escape }}</span>
            <strong>{{ member_price | money_with_currency }}</strong>
          </p>
        {% endif %}

        {% if regular_price != blank %}
          <p class="pdp-info-accordion__price-row">
            <span>{{ block_settings.regular_label | escape }}</span>
            <strong>{{ regular_price | money_with_currency }}</strong>
          </p>
        {% endif %}

        {% if block_settings.prices_content != blank %}
          <div class="rte">
            {{ block_settings.prices_content }}
          </div>
        {% endif %}
      </div>
    </details>
  {% endif %}

  {% if block_settings.show_fabric_care %}
    <div class="pdp-info-accordion__item pdp-info-accordion__download">
      {% if fabric_pdf != blank %}
        <a
          class="pdp-info-accordion__heading"
          href="{{ fabric_pdf.url }}"
          target="_blank"
          rel="noopener"
        >
          <span>{{ block_settings.fabric_care_heading | escape }}</span>
          <span class="pdp-info-accordion__arrow" aria-hidden="true">›</span>
        </a>
      {% else %}
        <div class="pdp-info-accordion__heading">
          <span>{{ block_settings.fabric_care_heading | escape }}</span>
          <span class="pdp-info-accordion__arrow" aria-hidden="true">›</span>
        </div>

        {% if request.design_mode %}
          <p class="pdp-info-accordion__content">
            Add a PDF to the product's Fabric care PDF metafield.
          </p>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

</div>

{% stylesheet %}
  .pdp-info-accordion {
    width: 100%;
    color: #333;
    font-size: 14px;
  }

  .pdp-info-accordion__item {
    margin: 0;
    border-bottom: 1px solid #999;
  }

  .pdp-info-accordion__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 0;
    color: inherit;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    text-decoration: none;
    list-style: none;
    cursor: pointer;
  }

  .pdp-info-accordion__heading::-webkit-details-marker {
    display: none;
  }

  .pdp-info-accordion__icon {
    position: relative;
    flex: 0 0 12px;
    width: 12px;
    height: 12px;
  }

  .pdp-info-accordion__icon::before,
  .pdp-info-accordion__icon::after {
    position: absolute;
    top: 50%;
    left: 1px;
    width: 10px;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .pdp-info-accordion__icon::after {
    transform: rotate(90deg);
  }

  .pdp-info-accordion__item[open]
  .pdp-info-accordion__icon::after {
    display: none;
  }

  .pdp-info-accordion__content {
    padding: 0 0 17px;
    font-size: 14px;
    line-height: 1.6;
  }

  .pdp-info-accordion__content p {
    margin-block: 0 8px;
  }

  .pdp-info-accordion__content ul,
  .pdp-info-accordion__list {
    margin: 0;
    padding-inline-start: 18px;
  }

  .pdp-info-accordion__content li {
    margin-bottom: 5px;
  }

  .pdp-info-accordion__price-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin: 0 0 10px;
  }

  .pdp-info-accordion__arrow {
    font-size: 22px;
    line-height: 1;
  }
{% endstylesheet %}

